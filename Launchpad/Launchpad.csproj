<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Launchpad</RootNamespace>
    <AssemblyName>Launchpad</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <ApplicationIcon>../icon.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    Linux → .NET 10, cross-compiled to win-x64, self-contained single file (~50 MB).
    The .NET runtime is bundled because Windows machines won't have it installed.
  -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <!--
    Windows → .NET Framework 4.7.2, small exe (~1-2 MB).
    .NET Framework 4.7.2 ships with Windows 10/11 so no runtime needs bundling.
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>

  <!-- Embed the app icon so MainForm can set it as the title-bar icon at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="../icon.ico">
      <Link>icon.ico</Link>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Extra references needed for .NET Framework 4.7.2 builds. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <!-- System.Net.Http is a framework assembly; SDK-style projects don't auto-reference it. -->
    <Reference Include="System.Net.Http" />
    <!-- System.Text.Json is built into .NET 6+; pull it as NuGet for Framework. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <!--
      Costura.Fody embeds all dependency DLLs as compressed resources inside the exe
      at build time, so the output is a single portable Launchpad.exe with no loose DLLs.
    -->
    <PackageReference Include="Fody" Version="6.8.2" PrivateAssets="all" />
    <PackageReference Include="Costura.Fody" Version="5.8.0" PrivateAssets="all" />
  </ItemGroup>

</Project>
