<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Launchpad</RootNamespace>
    <AssemblyName>Launchpad</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>10.0</LangVersion>
    <ApplicationIcon>../icon.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!--
    Linux → .NET 10, cross-compiled to win-x64, self-contained single file (~50 MB).
    The .NET runtime is bundled because Windows machines won't have it installed.
  -->
  <PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <!--
    Windows → .NET Framework 4.7.2, small exe (~1-2 MB).
    .NET Framework 4.7.2 ships with Windows 10/11 so no runtime needs bundling.
  -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>

  <!-- Embed the app icon so MainForm can set it as the title-bar icon at runtime. -->
  <ItemGroup>
    <EmbeddedResource Include="../icon.ico">
      <Link>icon.ico</Link>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Framework assemblies not auto-referenced by the SDK for net472 WinForms projects. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

</Project>
