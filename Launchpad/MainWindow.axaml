<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Launchpad"
        x:Class="Launchpad.MainWindow"
        Title="Stand Launchpad"
        SizeToContent="WidthAndHeight"
        CanResize="False">
    <!--
        Unified launcher — supports GTA V Legacy and GTA V Enhanced in one window.
        Layout mirrors the original Stand Launchpad 1.9.3 (senpai branch):
          Left col (270 px fixed) : always visible — mode toggle, launch/inject, checkbox, folder, advanced, status
          Right col (Auto)        : AdvancedPanel — delay row + DLL list (hidden until Advanced clicked)
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ── Left column ─────────────────────────────────────────────── -->
        <StackPanel Grid.Column="0" Margin="12" Spacing="6">

            <!-- Row 0: Game mode toggle -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <RadioButton x:Name="LegacyModeBtn"
                             Content="GTA V Legacy"
                             GroupName="GameMode"
                             IsChecked="True"
                             Checked="ModeBtn_Checked" />
                <RadioButton x:Name="EnhancedModeBtn"
                             Content="GTA V Enhanced"
                             GroupName="GameMode"
                             Checked="ModeBtn_Checked" />
            </StackPanel>

            <!-- Row 1: InjectBtn (game running) OR LaunchBtn + ComboBox -->
            <Grid>
                <Grid x:Name="LaunchRow" ColumnDefinitions="Auto,*">
                    <Button x:Name="LaunchBtn" Grid.Column="0" Content="Launch"
                            Margin="0,0,4,0" Click="LaunchBtn_Click"
                            HorizontalContentAlignment="Left" />
                    <ComboBox x:Name="LauncherType" Grid.Column="1"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="LauncherType_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="local:LauncherOption">
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Button x:Name="InjectBtn" Content="Inject" IsVisible="False"
                        HorizontalAlignment="Stretch" Click="InjectBtn_Click"
                        HorizontalContentAlignment="Left" />
            </Grid>

            <!-- Row 2: Auto-inject checkbox -->
            <CheckBox x:Name="AutoInjectCheckBox"
                      Content="Automatically inject when game starts."
                      Checked="AutoInjectCheckBox_Changed"
                      Unchecked="AutoInjectCheckBox_Changed" />

            <!-- Row 3: Open Stand/Game Folder -->
            <Button x:Name="OpenFolderBtn"
                    Content="Open Stand Folder"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OpenFolderBtn_Click" />

            <!-- Row 4: Advanced toggle -->
            <Button x:Name="AdvancedBtn" Content="Advanced"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="AdvancedBtn_Click" />

            <!-- Row 5: Check for Updates (Legacy mode only) -->
            <Button x:Name="CheckUpdateBtn"
                    Content="Check for Updates"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    IsVisible="True"
                    Click="CheckUpdateBtn_Click" />

            <!-- Row 6: Status + download progress -->
            <TextBlock x:Name="InfoText"
                       Text="Checking for updates..."
                       TextWrapping="Wrap" />

            <ProgressBar x:Name="DownloadProgress"
                         Minimum="0" Maximum="100"
                         IsVisible="False"
                         Height="6" />

        </StackPanel>

        <!-- ── Right column: Advanced panel ────────────────────────────── -->
        <StackPanel x:Name="AdvancedPanel" Grid.Column="1"
                    Margin="0,12,12,12" Spacing="6" IsVisible="False">

            <!-- Delay label + NUD + ↑↓ + Add + Remove -->
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <TextBlock Text="Automatic Injection Delay (Seconds):"
                           VerticalAlignment="Center" />
                <NumericUpDown x:Name="AutoInjectDelaySeconds"
                               Minimum="0" Maximum="60" Width="70"
                               ShowButtonSpinner="False" />
                <Button Content="+" Click="DelayUpBtn_Click"   Padding="5,4" />
                <Button Content="-" Click="DelayDownBtn_Click" Padding="5,4" />
                <Button Content="Add"    Click="AddBtn_Click"    Padding="8,4" />
                <Button Content="Remove" Click="RemoveBtn_Click" Padding="8,4" />
            </StackPanel>

            <!-- DLL list — 450 × 122 px, matching original ListView -->
            <ListBox x:Name="DllList" Width="450" Height="122" SelectionMode="Multiple">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="local:DllEntry" x:DataType="local:DllEntry">
                        <CheckBox Content="{Binding Path}" IsChecked="{Binding Checked}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- DLL reorder buttons (below the list) -->
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Move Up"   Click="UpBtn_Click"   Padding="8,4" />
                <Button Content="Move Down" Click="DownBtn_Click" Padding="8,4" />
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
